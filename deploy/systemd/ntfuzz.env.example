# /etc/ntfuzz/ntfuzz.env
# Shared environment variables read by both ntfuzz-serve.service and ntfuzz-view.service.

# Orchestrator tuning (used by ntfuzz-serve.service)
NTFUZZ_WORKERS=2
NTFUZZ_SNAPSHOT_INTERVAL=1m

# Viewer refresh cadence (used by ntfuzz-view.service)
NTFUZZ_VIEW_REFRESH=10s

# Optional browser dashboard branding (used by both serve and view)
# NTFUZZ_BRAND_NAME="Acme Security Lab"
# NTFUZZ_BRAND_URL="https://security.example.com"
# NTFUZZ_BRAND_ACCENT="#58A6FF"
