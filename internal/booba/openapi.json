{
  "openapi": "3.0.3",
  "info": {
    "title": "ntfuzz read API",
    "version": "1.0.0",
    "description": "Read endpoints shared by live serve and snapshot view. Check /api/status for read_only and snapshot_at. Does not describe private operator mutations."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/projects": {
      "get": {
        "summary": "List projects",
        "operationId": "getProject",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Query failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/targets": {
      "get": {
        "summary": "List active targets",
        "operationId": "getTarget",
        "parameters": [
          {
            "name": "project",
            "in": "query",
            "description": "Project ID or name.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Target"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Query failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "get": {
        "summary": "List runs, newest first",
        "operationId": "getRun",
        "parameters": [
          {
            "name": "target",
            "in": "query",
            "description": "Target ID, name, or project/name. Prefer numeric IDs to avoid ambiguity.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Positive row limit; missing or invalid values use the default.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Run"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Query failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/crashes": {
      "get": {
        "summary": "List crashes",
        "operationId": "getCrash",
        "parameters": [
          {
            "name": "target",
            "in": "query",
            "description": "Target ID, name, or project/name. Prefer numeric IDs to avoid ambiguity.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "open",
            "in": "query",
            "description": "Defaults to open only; false, 0, or all includes fixed crashes.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "1",
                "false",
                "0",
                "all"
              ],
              "default": "true"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Crash"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Query failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Invalid open parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/crashes/{id}": {
      "get": {
        "summary": "Get a single crash record by ID",
        "operationId": "getCrashById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Positive integer crash ID.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Crash"
                }
              }
            }
          },
          "400": {
            "description": "Invalid crash ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Crash not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Query failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/crashes/{id}/input": {
      "get": {
        "summary": "Download the Go fuzz corpus reproducer file for a crash",
        "operationId": "getCrashInput",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Positive integer crash ID.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Go fuzz v1 corpus file attachment",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "403": {
            "description": "Public input download is not enabled for this project in snapshot view mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Crash or stored input bytes not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/crashes/{id}/report.md": {
      "get": {
        "summary": "Render a shareable Markdown crash report for upstream maintainers",
        "operationId": "getCrashReportMarkdown",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Positive integer crash ID.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "public_url",
            "in": "query",
            "description": "Optional base URL override for permalink and input links in the rendered Markdown.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Markdown crash report",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Crash not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/crashes/{id}": {
      "get": {
        "summary": "Server-rendered HTML crash permalink (no JavaScript required)",
        "operationId": "getCrashHTML",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Positive integer crash ID.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Server-rendered HTML crash page",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Crash not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/coverage/history": {
      "get": {
        "summary": "Recent coverage points in chronological order; empty array without target",
        "operationId": "getCoveragePoint",
        "parameters": [
          {
            "name": "target",
            "in": "query",
            "description": "Target ID, name, or project/name. Prefer numeric IDs to avoid ambiguity.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Positive row limit; missing or invalid values use the default.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CoveragePoint"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Query failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/stats/{query}": {
      "get": {
        "summary": "Time-bucketed statistics and revision/recovery progress",
        "operationId": "getStatsResponse",
        "parameters": [
          {
            "name": "query",
            "in": "path",
            "description": "Canned query: throughput, coverage, outcomes, revisions, or burndown.",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "throughput",
                "coverage",
                "outcomes",
                "revisions",
                "burndown"
              ],
              "default": "throughput"
            }
          },
          {
            "name": "window",
            "in": "query",
            "description": "Lookback time window (1h, 6h, 24h, 7d, 14d).",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1h",
                "6h",
                "24h",
                "7d",
                "14d"
              ],
              "default": "24h"
            }
          },
          {
            "name": "project",
            "in": "query",
            "description": "Optional project ID or name filter.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "target",
            "in": "query",
            "description": "Optional target filter; unsupported for the project-level revisions query.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or window parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Query failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "summary": "Fleet status and snapshot freshness",
        "operationId": "getStatusResponse",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "500": {
            "description": "Query failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/crash-replays": {
      "get": {
        "summary": "Latest saved-input verification per crash, revision, and input (up to 1000 records)",
        "operationId": "listCrashReplays",
        "responses": {
          "200": {
            "description": "Replay history",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CrashReplay"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "git_sha": {
            "type": "string"
          },
          "dirty": {
            "type": "boolean"
          },
          "public_inputs": {
            "type": "boolean",
            "description": "Whether public snapshot viewers may serve GET /api/crashes/{id}/input for crashes in this project."
          },
          "sync_error": {
            "type": "string"
          },
          "last_synced": {
            "type": "string",
            "format": "date-time"
          },
          "target_count": {
            "type": "integer",
            "format": "int64"
          },
          "total_runs": {
            "type": "integer",
            "format": "int64"
          },
          "open_crashes": {
            "type": "integer",
            "format": "int64"
          },
          "latest_status": {
            "type": "string"
          },
          "last_run_at": {
            "type": "string",
            "format": "date-time"
          },
          "avg_execs_per_sec": {
            "type": "number",
            "format": "double"
          },
          "avg_coverage_pct": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "id",
          "name",
          "repo",
          "dirty",
          "public_inputs",
          "target_count",
          "total_runs",
          "open_crashes",
          "latest_status",
          "avg_execs_per_sec",
          "avg_coverage_pct"
        ]
      },
      "Target": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "project_id": {
            "type": "integer",
            "format": "int64"
          },
          "project_name": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "last_run_id": {
            "type": "integer",
            "format": "int64"
          },
          "last_started": {
            "type": "string",
            "format": "date-time"
          },
          "duration_sec": {
            "type": "number",
            "format": "double"
          },
          "execs": {
            "type": "integer",
            "format": "int64"
          },
          "execs_per_sec": {
            "type": "number",
            "format": "double"
          },
          "new_interesting": {
            "type": "integer",
            "format": "int64"
          },
          "corpus_count": {
            "type": "integer",
            "format": "int64"
          },
          "crashes": {
            "type": "integer",
            "format": "int64"
          },
          "coverage_pct": {
            "type": "number",
            "format": "double"
          },
          "status": {
            "type": "string"
          },
          "worker": {
            "type": "string"
          },
          "git_sha": {
            "type": "string"
          },
          "dirty": {
            "type": "boolean"
          },
          "go_version": {
            "type": "string"
          },
          "open_crashes": {
            "type": "integer",
            "format": "int64"
          },
          "total_runs": {
            "type": "integer",
            "format": "int64"
          },
          "coverage_trend": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "nullable": true
          }
        },
        "required": [
          "id",
          "project_id",
          "project_name",
          "package",
          "name",
          "duration_sec",
          "execs",
          "execs_per_sec",
          "new_interesting",
          "corpus_count",
          "crashes",
          "coverage_pct",
          "status",
          "worker",
          "dirty",
          "open_crashes",
          "total_runs",
          "coverage_trend"
        ]
      },
      "Run": {
        "type": "object",
        "properties": {
          "diagnostic": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "target_id": {
            "type": "integer",
            "format": "int64"
          },
          "project_name": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "target_name": {
            "type": "string"
          },
          "started": {
            "type": "string",
            "format": "date-time"
          },
          "duration_sec": {
            "type": "number",
            "format": "double"
          },
          "execs": {
            "type": "integer",
            "format": "int64"
          },
          "execs_per_sec": {
            "type": "number",
            "format": "double"
          },
          "new_interesting": {
            "type": "integer",
            "format": "int64"
          },
          "corpus_count": {
            "type": "integer",
            "format": "int64"
          },
          "crashes": {
            "type": "integer",
            "format": "int64"
          },
          "coverage_pct": {
            "type": "number",
            "format": "double"
          },
          "status": {
            "type": "string"
          },
          "worker": {
            "type": "string"
          },
          "git_sha": {
            "type": "string"
          },
          "dirty": {
            "type": "boolean"
          },
          "go_version": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "target_id",
          "started",
          "duration_sec",
          "execs",
          "execs_per_sec",
          "new_interesting",
          "corpus_count",
          "crashes",
          "coverage_pct",
          "status",
          "worker",
          "dirty"
        ]
      },
      "Crash": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "target_id": {
            "type": "integer",
            "format": "int64"
          },
          "project_name": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "target_name": {
            "type": "string"
          },
          "public_inputs": {
            "type": "boolean",
            "description": "Whether the project allows public corpus input downloads in snapshot view mode."
          },
          "first_seen": {
            "type": "string",
            "format": "date-time"
          },
          "last_seen": {
            "type": "string",
            "format": "date-time"
          },
          "fixed_at": {
            "type": "string",
            "format": "date-time"
          },
          "stack": {
            "type": "string"
          },
          "stack_fingerprint": {
            "type": "string"
          },
          "input_hash": {
            "type": "string"
          },
          "minimized_input": {
            "type": "string",
            "description": "Server-local corpus path. Use GET /api/crashes/{id}/input to download the corpus file when public_inputs is enabled (or in serve mode)."
          },
          "input_truncated": {
            "type": "boolean",
            "description": "True if the stored input exceeded the 64 KiB database cap."
          },
          "issue_url": {
            "type": "string"
          },
          "git_sha": {
            "type": "string"
          },
          "dirty": {
            "type": "boolean"
          },
          "go_version": {
            "type": "string"
          },
          "blamed_module": {
            "type": "string"
          },
          "blamed_version": {
            "type": "string"
          },
          "blamed_file": {
            "type": "string"
          },
          "blamed_line": {
            "type": "integer",
            "format": "int64"
          },
          "blamed_url": {
            "type": "string"
          },
          "replay_status": {
            "type": "string"
          },
          "replay_git_sha": {
            "type": "string"
          },
          "replay_checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "replay_diagnostic": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "target_id",
          "public_inputs",
          "first_seen",
          "last_seen",
          "stack",
          "input_hash",
          "minimized_input",
          "input_truncated",
          "issue_url",
          "dirty"
        ]
      },
      "CoveragePoint": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "integer",
            "format": "int64"
          },
          "target_id": {
            "type": "integer",
            "format": "int64"
          },
          "started": {
            "type": "string",
            "format": "date-time"
          },
          "coverage_pct": {
            "type": "number",
            "format": "double"
          },
          "execs_per_sec": {
            "type": "number",
            "format": "double"
          },
          "new_interesting": {
            "type": "integer",
            "format": "int64"
          },
          "corpus_count": {
            "type": "integer",
            "format": "int64"
          },
          "git_sha": {
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "target_id",
          "started",
          "coverage_pct",
          "execs_per_sec",
          "new_interesting",
          "corpus_count"
        ]
      },
      "ActiveJob": {
        "type": "object",
        "properties": {
          "worker_id": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "fuzztime": {
            "type": "string"
          },
          "git_sha": {
            "type": "string"
          },
          "dirty": {
            "type": "boolean"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
